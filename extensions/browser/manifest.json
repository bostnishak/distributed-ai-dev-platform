{
  "manifest_version": 3,
  "name": "DADP Yerel Yapay Zeka Asistanı",
  "version": "2.0.0",
  "description": "Seçili metni veya aktif sayfayı yalnızca açık kullanıcı onayıyla yerel/Tailscale DADP Master sunucusuna gönderir.",
  "permissions": ["activeTab", "scripting", "sidePanel", "contextMenus", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DADP Asistan"
  }
}
