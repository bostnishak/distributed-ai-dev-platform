# Example only: never put real values here. Copy this file to ".env" (never committed) and
# fill in the values there. The system runs 100% locally; no cloud LLM API keys are needed.

# --- LiteLLM gateway (Assistant tab) ---
# A random string starting with "sk-", e.g. "sk-" followed by: openssl rand -hex 32
LITELLM_MASTER_KEY=

# --- Master ---
# Used when the master runs outside Docker (Docker Compose sets its own value).
GATEWAY_BASE_URL=http://localhost:4000

# Shared secret agents send when registering with the master, e.g.: openssl rand -hex 32
# Share it with teammates privately; never commit it.
AGENT_TOKEN=

# The Assistant's "Run" button executes Python on the master. The web UI has no login yet,
# so anyone who can reach the master could use it. Set to true only on a trusted network.
CODE_RUN_ENABLED=false
