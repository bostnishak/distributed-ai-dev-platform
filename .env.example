# Bu dosya SADECE örnektir — gerçek değerleri buraya yazmayın.
# Kendi ".env" dosyanızı oluşturup değerleri orada doldurun (.env asla commit edilmez).
#
# NOT: Sistem %100 lokal çalışır (veri gizliliği kararı) — bulut LLM API key'i gerekmiyor.

# --- LiteLLM Gateway ---
# Rastgele bir string üretip buraya koyun (ör: openssl rand -hex 32), "sk-" ile başlamalı
LITELLM_MASTER_KEY=

# --- Orkestratör ---
GATEWAY_BASE_URL=http://localhost:4000
