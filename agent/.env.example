# Example only. agent-node/setup.ps1 (or setup.sh) creates the real agent/.env for you.
# agent/.env holds a secret (AGENT_TOKEN) and is never committed.

# Your agent's id and the model assigned to you (see agent-node/README.md)
AGENT_ID=uye2
MEMBER_NAME=Zeynep Duru Küçük
MODEL=phi4-mini

# The master's address on the team's Tailscale network, e.g. http://<master-computer-name>:8000
MASTER_URL=
# Shared secret, sent to you privately by the person running the master
AGENT_TOKEN=

# Your local Ollama (it only listens on this computer)
OLLAMA_URL=http://127.0.0.1:11434
AGENT_MODE=node
