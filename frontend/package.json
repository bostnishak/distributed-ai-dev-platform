{
  "name": "distributed-ai-platform-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "UX-01, UX-19, UX-28: Offline-first frontend build, lint, typecheck, unit & Playwright E2E toolchain (zero CDN).",
  "scripts": {
    "lint": "eslint ../master/static/js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build --outDir ../master/static/dist",
    "e2e": "playwright test"
  },
  "performanceBudget": {
    "coreGzipMaxKb": 300,
    "maxFileLines": 500,
    "lighthouseMinPerformance": 90
  }
}
